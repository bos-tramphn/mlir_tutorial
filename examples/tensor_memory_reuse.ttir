module attributes {
  toy.slot0_capacity = 60 : i64,
  toy.slot1_capacity = 50 : i64,
  toy.slot2_capacity = 50 : i64,
  toy.slot3_capacity = 40 : i64,
  toy.slot4_capacity = 30 : i64
} {
  func.func @tensor_memory_reuse_graph(%input: tensor<?xf64>) -> tensor<?xf64> {
    // op0: %a = conv(%input)
    %a = "toy.conv"(%input) {tensor_size = 40 : i64, workspace_size = 30 : i64}
         : (tensor<?xf64>) -> tensor<?xf64>

    // op1: %b = relu(%a)
    %b = "toy.relu"(%a) {tensor_size = 40 : i64, workspace_size = 5 : i64}
         : (tensor<?xf64>) -> tensor<?xf64>

    // op2: %c = conv(%a)
    %c = "toy.conv"(%a) {tensor_size = 30 : i64, workspace_size = 30 : i64}
         : (tensor<?xf64>) -> tensor<?xf64>

    // op3: %d = mul(%c)
    // Note: toy.mul is binary in this starter dialect, so we model this as mul(%c, %c).
    %d = "toy.mul"(%c, %c) {tensor_size = 30 : i64, workspace_size = 10 : i64}
         : (tensor<?xf64>, tensor<?xf64>) -> tensor<?xf64>

    // op4: %e = add(%b, %d)
    %e = "toy.add"(%b, %d) {tensor_size = 40 : i64, workspace_size = 8 : i64}
         : (tensor<?xf64>, tensor<?xf64>) -> tensor<?xf64>

    // op5: %f = relu(%e)
    %f = "toy.relu"(%e) {tensor_size = 40 : i64, workspace_size = 5 : i64}
         : (tensor<?xf64>) -> tensor<?xf64>

    // op6: %g = conv(%e)
    %g = "toy.conv"(%e) {tensor_size = 50 : i64, workspace_size = 30 : i64}
         : (tensor<?xf64>) -> tensor<?xf64>

    // op7: %h = sub(%g, %a)
    %h = "toy.sub"(%g, %a) {tensor_size = 50 : i64, workspace_size = 8 : i64}
         : (tensor<?xf64>, tensor<?xf64>) -> tensor<?xf64>

    // op8: %i = add(%f, %h)
    %i = "toy.add"(%f, %h) {tensor_size = 50 : i64, workspace_size = 8 : i64}
         : (tensor<?xf64>, tensor<?xf64>) -> tensor<?xf64>

    // op9: %j = conv(%i)
    %j = "toy.conv"(%i) {tensor_size = 60 : i64, workspace_size = 30 : i64}
         : (tensor<?xf64>) -> tensor<?xf64>

    return %j : tensor<?xf64>
  }
}
